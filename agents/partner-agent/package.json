{
  "name": "partner-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal eve partner agent with a configurable model provider (Azure OpenAI, Vercel AI Gateway, or OmniRoute).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "eve dev --no-default-extensions",
    "build": "eve build",
    "start": "eve start",
    "info": "eve info",
    "test": "vitest run tests/model.test.ts",
    "test:live": "vitest run tests/live.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ai-sdk/azure": "^4.0.100",
    "@ai-sdk/openai-compatible": "^3.0.68",
    "ai": "^7.0.138",
    "eve": "^0.78.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
