# ==========================================================================
#  AGENT SETTINGS
# ==========================================================================
#  This file chooses which AI service the agent uses, and holds the
#  passwords ("API keys") for those services.
#
#  HOW TO EDIT
#   1. Change only the text AFTER the = sign.
#      No spaces around =, no quotes, nothing after the value.
#   2. Lines that start with # are notes. The agent ignores them.
#   3. Save the file, then RESTART the agent: in its terminal press
#      Ctrl+C, then type  npm run dev  and press Enter.
#      Changes are not used until you restart.
#
#  KEEP IT PRIVATE
#   This file holds secret keys. Never share it, paste it into a chat,
#   or upload it anywhere. Git ignores it automatically.
#
#  FIRST TIME?  Copy this file and name the copy  .env.local
#  Full guide with examples and help for error messages: SETTINGS.md
# ==========================================================================


# --------------------------------------------------------------------------
#  STEP 1 - CHOOSE THE AI SERVICE
# --------------------------------------------------------------------------
#  Write exactly one of these words after the = sign:
#
#    azure      Microsoft Azure OpenAI. The company account, model gpt-4o-mini.
#    gateway    Vercel AI Gateway. Hundreds of models (OpenAI, Anthropic,
#               Google, ...). Paid per use.
#    omniroute  OmniRoute on this computer. Free models. OmniRoute must be
#               running (Docker).
#
#  Example:  MODEL_PROVIDER=azure
MODEL_PROVIDER=azure


# --------------------------------------------------------------------------
#  STEP 2 - FILL IN THE SECTION FOR THE SERVICE YOU CHOSE
#  You can leave the other sections as they are.
# --------------------------------------------------------------------------

# ---------- A) Azure OpenAI  (MODEL_PROVIDER=azure) -----------------------
#  Ask your Azure administrator for these three values.

#  The secret key for the Azure OpenAI resource.
AZURE_AI_CHATBOT_API_KEY=

#  The web address of the Azure OpenAI resource. It must start with
#  https:// and end with /openai/v1
#  Example:  https://my-company.openai.azure.com/openai/v1
AZURE_AI_CHATBOT_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1

#  The name of the model deployment in Azure.
#  Example:  gpt-4o-mini
AZURE_AI_CHATBOT_DEPLOYMENT_NAME=gpt-4o-mini


# ---------- B) Vercel AI Gateway  (MODEL_PROVIDER=gateway) ----------------
#  Get the key in the Vercel dashboard: AI Gateway > API Keys > Create key.
#  The Vercel account needs a credit card on file.
AI_GATEWAY_API_KEY=

#  Which model to use, written as company/model. Examples:
#    openai/gpt-4o-mini   anthropic/claude-haiku-4.5   google/gemini-2.5-flash
GATEWAY_MODEL_ID=openai/gpt-4o-mini


# ---------- C) OmniRoute  (MODEL_PROVIDER=omniroute) ----------------------
#  Create the key in the OmniRoute dashboard (http://localhost:20128)
#  under API Keys.
OMNIROUTE_API_KEY=

#  Which model to use, from OmniRoute's model list.
#  auto/best-free picks the best free model each time.
OMNIROUTE_MODEL_ID=auto/best-free

#  Leave empty to use the standard address: http://localhost:20128/v1
OMNIROUTE_BASE_URL=


# --------------------------------------------------------------------------
#  PLANNER - Gemini key (Claude Code planner agent)
# --------------------------------------------------------------------------
#  OPTIONAL. Lets the planner agent make at most ONE workflow image,
#  only after you approve. Without it, plans use a free Mermaid diagram. Images are not free: about $0.034 each.
#  Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=


# --------------------------------------------------------------------------
#  ADVANCED - usually leave empty
# --------------------------------------------------------------------------
#  How much text the model can read at once, in tokens.
#  Empty = automatic (128000 for azure and omniroute, the catalog value for gateway).
MODEL_CONTEXT_WINDOW=
